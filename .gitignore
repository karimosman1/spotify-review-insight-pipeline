# ---- large regenerable intermediates ----
# Full per-record output and the result cache. The graded evidence lives in grading/
# (records.jsonl.gz, calls.jsonl.gz); these are the pipeline's working files and can be
# regenerated by rerunning the stage. Kept out to keep the repo clonable.
runs/*/results.jsonl
runs/*/cache.jsonl
runs/*/calls.jsonl
runs/*/verify_cache.jsonl
runs/check10k/
runs/w1/
runs/w8/
runs/pilot-*/
runs/system_tests/

# Database seed CSVs: regenerate with `python3 db/load_db.py --dry-run`
db/seed/

